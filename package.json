{
  "name": "herdr-web-broker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test 'dist/test/**/*.test.js' && npm run test:scripts",
    "test:scripts": "node --test 'scripts/*.test.mjs'",
    "release:check": "node scripts/release.mjs --check-only",
    "release:local": "npm run build && node scripts/release.mjs"
  },
  "dependencies": {
    "smol-toml": "^1.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.10",
    "typescript": "~6.0.0"
  }
}
