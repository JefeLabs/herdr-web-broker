{
  "name": "@jefelabs/herdr-broker-react",
  "version": "0.2.0",
  "description": "Headless React layer for herdr-web-broker: every behavior hook (auth gate, pane viewer, repo browser, events panel) with zero markup \u2014 the base for any design-system skin",
  "keywords": [
    "herdr",
    "agents",
    "react",
    "hooks",
    "headless"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JefeLabs/herdr-web-broker.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/JefeLabs/herdr-web-broker#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@jefelabs/herdr-broker-client": "^0.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.0"
  }
}
